# babyg — environment variables
# Copy to .env for local development. Never commit .env.
# All values are server-side only. Never expose any of these to templates or client JS.

# ============================================================================
# Required for the web tier to boot and serve traffic.
# ============================================================================

# --- Application ---
ENV=dev                                  # dev | staging | production
APP_URL=http://localhost:8000            # default app origin and OAuth callback base
PUBLIC_APP_URL=                          # canonical magic-link origin; e.g. https://www.babyg.ai
SESSION_SECRET=                          # generate with: python scripts/generate_session_secret.py

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Integrations. Blank keys keep the app booting; features that need them
# no-op gracefully. Settings reads via pydantic's `extra="ignore"`.
# ============================================================================

# --- Anthropic (Claude) — AI assistant / agent ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Tavily (web search for the AI agent) ---
TAVILY_API_KEY=

# --- Google (Gmail + Calendar — single OAuth grant) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/creator/google/calendar/callback
# gmail.compose covers read + draft creation. babyg's integration module
# exposes no send / delete / label-modify endpoints, so the broader scope
# is bounded at the code surface even though Google's scope itself allows
# more. Calendar.events covers read + write for the existing approval flow.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/calendar.events

# --- Instagram / Meta (read-only insights) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
