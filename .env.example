# babyg — environment variables
# Copy to .env for local development. Never commit .env.
# All values are server-side only. Never expose any of these to templates or client JS.

# ============================================================================
# Phase 1 — required for the web tier to boot and serve traffic.
# ============================================================================

# --- Application ---
ENV=dev                                  # dev | staging | production
APP_URL=http://localhost:8000            # used for OAuth callbacks and email links
SESSION_SECRET=                          # generate with: python scripts/generate_session_secret.py

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Phase 2 — leave blank until the corresponding code lands. Settings reads
# them via pydantic's `extra="ignore"` so Railway/Vercel can keep these
# defined ahead of time without breaking boot.
# ============================================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Redis (Upstash) ---
REDIS_URL=
CELERY_BROKER_URL=

# --- Tavily (web search) ---
TAVILY_API_KEY=

# --- Google (Gmail + Calendar — single OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events

# --- Instagram ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- OpenTable ---
OPENTABLE_CLIENT_ID=
OPENTABLE_CLIENT_SECRET=

# --- Twilio (SMS for VIP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Resend (transactional email — Supabase SMTP uses it; app uses it later) ---
RESEND_API_KEY=

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_PUBLIC_KEY=

# --- Sentry ---
SENTRY_DSN=
