# babyg — environment variables
# Copy to .env for local development. Never commit .env.
# All values are server-side only. Never expose any of these to templates or client JS.

# --- Application ---
ENV=dev                                  # dev | staging | production
APP_URL=http://localhost:8000            # used for OAuth callbacks and email links
SESSION_SECRET=                          # generate with: python scripts/generate_session_secret.py

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Redis (Upstash) ---
REDIS_URL=
CELERY_BROKER_URL=

# --- Tavily (web search) ---
TAVILY_API_KEY=

# --- Google (Gmail + Calendar — single OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events

# --- Instagram ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Resy ---
RESY_API_KEY=
RESY_AUTH_TOKEN=

# --- OpenTable ---
OPENTABLE_CLIENT_ID=
OPENTABLE_CLIENT_SECRET=

# --- Duffel (flights/hotels) ---
DUFFEL_API_KEY=

# --- Twilio (SMS for VIP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Resend (transactional email + magic links) ---
RESEND_API_KEY=

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_PUBLIC_KEY=

# --- Sentry ---
SENTRY_DSN=

# --- Feature flags ---
SCOPE_PRECHECK_ENABLED=true
TOOL_USE_ENABLED=true
